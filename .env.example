DISCORD_TOKEN=
CLIENT_ID=
# optional, registers slash commands to one server instantly instead of globally
GUILD_ID=

# any long random string, shared by the bot and both lavalink nodes
LAVALINK_PASSWORD=

# free client id from devportal.jamendo.com
JAMENDO_ID=

# on or off. youtube runs on its own node so the rest keeps playing when it breaks
YOUTUBE=off

# where the sqlite file lives
DB_PATH=tempestune.db
