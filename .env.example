DISCORD_TOKEN=
CLIENT_ID=
# optional, registers slash commands to one server instantly instead of globally
GUILD_ID=

# any long random string, shared by the bot and both lavalink nodes
LAVALINK_PASSWORD=

# free client id from devportal.jamendo.com
JAMENDO_ID=

# on or off. youtube runs on its own node so the rest keeps playing when it breaks
YOUTUBE=off

# where the sqlite file lives
DB_PATH=tempestune.db

# optional: port for the local track relay, and how big its cache may grow
RELAY_PORT=2340
CACHE_MB=2048

# text commands start with this, like "tt p faded" (mentioning the bot works too)
PREFIX=tt

# free api account from last.fm/api/account/create, for scrobbling. leave empty to keep last.fm off
LASTFM_KEY=
LASTFM_SECRET=
